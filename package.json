{
	"name": "constellation",
	"version": "0.1.0",
	"description": "A Universe of Libraries — Desktop knowledge management platform for connected notes",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build --config vite.screen.config.js",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "tauri",
		"build:tradition-manifests": "node scripts/build-tradition-manifests.mjs",
		"predev": "node scripts/build-tradition-manifests.mjs",
		"prebuild": "node scripts/build-tradition-manifests.mjs",
		"test:sight-v6:perf": "vitest run tests/sight-v6/perf.test.ts tests/sight-v6/tradition-perf.test.ts",
		"test:sight-v6:layout": "echo 'Layout-fidelity playwright runner still deferred. See tests/sight-v6/README.md.' && exit 0",
		"test:sight-v6": "vitest run tests/sight-v6/",
		"test:mig-060": "vitest run tests/mig-060/"
	},
	"license": "MIT",
	"dependencies": {
